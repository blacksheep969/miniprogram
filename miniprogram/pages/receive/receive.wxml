<view class="container">
  <text class="title">拼车详情</text>

  <view wx:if="{{carpool}}">
    <view class="info-box">
      <text class="info">📅 日期：{{carpool.date}}</text>
      <text class="info">⏰ 最佳时间：{{carpool.bestTime}}</text>
      <text class="info">⏳ 可接受时间：{{carpool.timeRange}}</text>
      <text class="info">👥 已有：{{carpool.peopleCount}} 人</text>
      <text class="info">🚻 性别要求：{{carpool.genderRequirement}}</text> <!-- ✅ 只显示性别要求 -->
      <text class="info">🎒 当前行李负担：{{carpool.luggageLoad}}人份</text> <!-- ✅ 让用户清楚行李状况 -->
    </view>

    <text class="label">您的微信号</text>
    <input class="input-box" type="text" placeholder="请复制您的微信号" bindinput="onWechatIdInput"/>

    <button class="pay-button" bindtap="confirmAndPay">确认并支付 试运营期间最底价0.01元</button>
  </view>

  <view wx:else>
    <text class="loading">加载中...</text>
  </view>
</view>