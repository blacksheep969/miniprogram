.container {
    padding: 20rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
  }
  
  .title {
    font-size: 36rpx;
    font-weight: bold;
    text-align: center;
    margin-bottom: 20rpx;
  }
  
  .info-box {
    background-color: #ffffff;
    padding: 20rpx;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
    margin-bottom: 20rpx;
  }
  
  .info {
    display: block;
    font-size: 30rpx;
    margin-bottom: 10rpx;
  }
  
  .member-list {
    background-color: #ffffff;
    padding: 20rpx;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
    margin-bottom: 20rpx;
  }
  
  .member-title {
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
  }
  
  .member-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 28rpx;
    padding: 10rpx 0;
    border-bottom: 1rpx solid #e0e0e0;
  }
  
  .member-label {
    font-weight: bold;
  }
  
  .member-wechat {
    color: #007aff;
  }
  
  .notice {
    padding: 20rpx;
    background-color: #fffbe6;
    border-radius: 12rpx;
    text-align: center;
    font-size: 28rpx;
    margin-top: 20rpx;
  }
  
  .notice-text {
    display: block;
    color: #ff9800;
    margin-bottom: 10rpx;
  }
  .exit-button {
    background-color: #ff4d4f; /* 红色 */
    color: white;
    font-size: 16px;
    padding: 12px;
    border-radius: 8px;
    margin-top: 20px;
  }