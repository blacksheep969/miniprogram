.container {
    padding: 20rpx;
}

.title {
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    text-align: center;
}

/* ✅ 让列表变成可滚动 */
.scroll-container {
    height: calc(80vh - 120rpx); /* 🚀 让滚动区域占满 80% 视口减去按钮的高度 */
    overflow-y: auto;
    margin-top: 10px;
}

/* ✅ 让拼车项更清晰 */
.carpool-item {
    padding: 12px;
    border-radius: 8px;
    background-color: #f9f9f9;
    margin-bottom: 10rpx;
    border: 1px solid #ddd;
}

.route-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 10rpx;
}

.time {
    font-size: 28rpx;
    color: #666;
    display: block;
    margin-bottom: 15rpx;
}

.detail-button {
    width: 100%;
    height: 80rpx;
    background-color: #007AFF;
    color: #ffffff;
    font-size: 32rpx;
    text-align: center;
    line-height: 80rpx;
    border-radius: 10rpx;
}

.empty-box {
    margin-top: 50rpx;
    text-align: center;
}

.empty-text {
    font-size: 32rpx;
    color: #999;
}

/* 新增：灰色的小字 */
.info-text {
    font-size: 24rpx;
    color: #888;
    margin-bottom: 20rpx;
    text-align: center;
}

/* 新增：反馈按钮样式 */
.feedback-button-box {
    margin-top: 20rpx;
    text-align: center;
}

.feedback-button {
    width: 80%;
    padding: 12rpx;
    background-color: #4CAF50;
    color: white;
    font-size: 32rpx;
    border-radius: 8rpx;
}

/* 让信息行排列整齐 */
.info-line {
    margin-top: 5px;
    display: block;
  }
  
  /* 让“我是车头”加粗 */
  .head-label {
    font-weight: bold;
    color: red;
  }
  
  /* 让行李信息有区分 */
  .info {
    font-size: 16px;
    color: #333;
  }