.container {
    padding: 20rpx;
  }
  
  .title {
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    text-align: center;
  }
  
  .feedback-input {
    width: 100%;
    height: 200rpx;
    padding: 10rpx;
    margin-bottom: 20rpx;
    border-radius: 8px;
    border: 1px solid #ddd;
    font-size: 28rpx;
  }
  
  .button-box {
    margin-top: 20rpx;
    text-align: center;
  }
  
  .feedback-submit {
    width: 80%;
    padding: 12rpx;
    background-color: #4CAF50;
    color: white;
    font-size: 32rpx;
    border-radius: 8rpx;
  }
  
  .contact-info {
    margin-top: 20rpx;
    text-align: center;
  }
  
  .contact-text {
    font-size: 24rpx;
    color: #888;
  }
  
  .wechat-id {
    color: #007aff;
    text-decoration: underline;
  }
  