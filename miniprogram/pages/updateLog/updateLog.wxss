.container {
    padding: 20rpx;
    background-color: #f5f5f5;
    min-height: 100vh;
}
  
.title {
    font-size: 36rpx;
    font-weight: bold;
    text-align: center;
    margin-bottom: 20rpx;
}
  
.log-container {
    background-color: #ffffff;
    padding: 20rpx;
    border-radius: 12rpx;
    box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
    margin-bottom: 20rpx;
}
  
.log-item {
    padding: 20rpx;
    border-bottom: 1px solid #ddd;
}
  
.log-title {
    font-weight: bold;
    font-size: 32rpx;
    color: #333;
    display: block;
}
  
.log-date {
    font-size: 28rpx;
    color: #666;
    margin-top: 5rpx;
    display: block;
}
  
.log-content {
    margin-top: 10rpx;
}
  
.log-text {
    display: block;
    font-size: 28rpx;
    color: #444;
    margin-top: 5rpx;
}
