.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
  }
  
  .title {
    font-size: 20px;
    margin-bottom: 20px;
  }
  
  .nowrap {
    white-space: nowrap; /* 让文本始终在同一行 */
    display: inline-block; /* 确保不会自动折行 */
  }
  
  /* ✅ 按钮美观优化 */
  .route-list button {
    width: 90%;
    font-size: 18px;
    font-weight: bold;
    text-align: center;
    padding: 12px;
    margin: 5px;
    border-radius: 8px;
  }

  .update-box {
    margin-top: 20px;
    text-align: center;
  }
  
  /* ✅ 限制按钮的最大宽度，使文字两行展示 */
  .update-button {
    width: 90%;
    max-width: 200px; /* 🚀 控制按钮宽度，保证换行 */
    font-size: 16px;
    font-weight: bold;
    text-align: center;
    padding: 10px;
    background-color: #007aff;
    color: white;
    border-radius: 8px;
    word-break: break-word; /* ✅ 允许换行 */
    white-space: pre-wrap; /* ✅ 确保 4 个字一行 */
    line-height: 1.5; /* ✅ 增加行高，防止拥挤 */
  }