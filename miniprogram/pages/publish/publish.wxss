.label {
    font-size: 18px;
    font-weight: bold;
    margin-top: 15px;
}

.select-box {
    font-size: 16px;
    padding: 10px;
    margin: 5px 0;
    border: 1px solid #ddd;
    border-radius: 5px;
    background-color: #f9f9f9;
    text-align: center;
}

.input-box {
    font-size: 16px;
    padding: 10px;
    margin: 5px 0;
    border: 1px solid #ddd;
    border-radius: 5px;
    width: 100%;
}

.gray-input {
    background-color: #f9f9f9;
    color: #333;
}

/* 时间选择框 */
.time-picker {
    display: flex;
    justify-content: space-between;
    margin: 10px 0;
}

.time-picker picker {
    width: 45%;
    text-align: center;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
}

/* 让发布按钮固定在页面底部 */
.bottom-button {
    position: fixed;
    bottom: 20px;
    width: 100%;
    text-align: center;
}

/* 设置发布按钮为绿色 */
.green-button {
    width: 90%;
    font-size: 18px;
    font-weight: bold;
    color: white;
    background-color: #4CAF50;
    border: none;
    padding: 12px;
    border-radius: 8px;
}

/* 页面内容区域的 padding */
.container {
    padding-bottom: 80px; /* 防止内容被固定按钮遮挡 */
}