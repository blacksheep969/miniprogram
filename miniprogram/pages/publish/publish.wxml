<view class="container">
    <text class="label">我想在哪一天出发？</text>
  <picker mode="selector" range="{{dateOptions}}" bindchange="onDateChange">
    <view class="select-box">{{ selectedDate || "请选择日期" }}</view>
  </picker>

  <text class="label">我最希望在什么时候出发？</text>
  <view class="time-picker">
    <picker mode="selector" range="{{hours}}" bindchange="onHourChange">
      <view class="select-box">{{ selectedHour !== null ? selectedHour + " 时" : "选择小时" }}</view>
    </picker>
    <picker mode="selector" range="{{minutes}}" bindchange="onMinuteChange">
      <view class="select-box">{{ selectedMinute !== null ? selectedMinute + " 分" : "选择分钟" }}</view>
    </picker>
  </view>

  <text class="label">我最早愿意什么时候出发？</text>
  <view class="time-picker">
    <picker mode="selector" range="{{hours}}" bindchange="onStartHourChange">
      <view class="select-box">{{ startHour !== null ? startHour + " 时" : "选择小时" }}</view>
    </picker>
    <picker mode="selector" range="{{minutes}}" bindchange="onStartMinuteChange">
      <view class="select-box">{{ startMinute !== null ? startMinute + " 分" : "选择分钟" }}</view>
    </picker>
  </view>

  <text class="label">我最迟愿意什么时候出发？</text>
  <view class="time-picker">
    <picker mode="selector" range="{{hours}}" bindchange="onEndHourChange">
      <view class="select-box">{{ endHour !== null ? endHour + " 时" : "选择小时" }}</view>
    </picker>
    <picker mode="selector" range="{{minutes}}" bindchange="onEndMinuteChange">
      <view class="select-box">{{ endMinute !== null ? endMinute + " 分" : "选择分钟" }}</view>
    </picker>
  </view>

  <text class="label">和我一起的已经有几人了？</text>
  <picker mode="selector" range="{{peopleOptions}}" bindchange="onPeopleCountChange">
    <view class="select-box">{{ peopleCount || "请填入已有几人" }}</view>
  </picker>

  <text class="label">我有多少行李要放后备箱？（一辆车最多4人份）</text>
<picker mode="selector" range="{{luggageOptions}}" bindchange="onLuggageChange">
  <view class="select-box">{{ selectedLuggage || "请选择行李情况" }}</view>
</picker>

  <text class="label">我对性别有要求吗？</text>
  <picker mode="selector" range="{{genderOptions}}" bindchange="onGenderChange">
    <view class="select-box">{{ selectedGender || "请选择性别要求" }}</view>
  </picker>

  <text class="label">我的微信号是：</text>
  <input class="input-box gray-input" type="text" placeholder="请复制您的微信号并填入" bindinput="onWechatIdChange"/>

  <!-- ✅ 发布按钮移动到底部，并设置绿色背景 -->
  <view class="bottom-button">
    <button class="green-button" bindtap="submitForm">发布并支付 试运营期间最底价0.01元</button>
  </view>
</view>